# flyto-modules-lerobot -- the execution host's runtime configuration.
# Everything about the arm itself (LeRobot robot type, serial port,
# calibration id, joint limits, gripper values, taught poses) lives in one
# arm config file; see examples/am-arm200.json.

# Path to this computer's arm config (.json or .toml). Empty means this
# computer serves no arm.
FLYTO_LEROBOT_ARM_CONFIG=
# Set to 0/false/off/no to stop reporting the arm to AI Space.
FLYTO_LEROBOT_AUTODISCOVER=1
